#!/bin/bash
# litho-theme - switch the sway desktop (sway, mako, waybar, wofi,
# swaylock, kitty, Firefox, Thunderbird) between Litho Dark and Litho Light
# in one go.
# See ~/.cfg-tzevaot/swaywm/litho/README.md for how the theme is wired
# up, and how it coexists with the other theme families.
#
# Usage: litho-theme dark|light|toggle|status

set -euo pipefail

LITHO_DIR="$HOME/.cfg-tzevaot/swaywm/litho"
ACTIVE_LINK="$LITHO_DIR/active"
SWAYLOCK_CFG="$HOME/.cfg-tzevaot/swaywm/swaylock/config"
KITTY_CONF="$HOME/.cfg-tzevaot/kitty/kitty.conf"
SWAY_CONF="$HOME/.cfg-tzevaot/swaywm/sway/config"
MAKO_CONF="$HOME/.cfg-tzevaot/swaywm/mako/config"
WAYBAR_CSS="$HOME/.cfg-tzevaot/swaywm/waybar/style.css"
WOFI_CSS="$HOME/.cfg-tzevaot/swaywm/wofi/style.css"

current_variant() {
    readlink "$ACTIVE_LINK" 2>/dev/null || echo "dark"
}

usage() {
    echo "Usage: litho-theme dark|light|toggle|status"
    exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
    dark|light)
        target="$1"
        ;;
    toggle)
        case "$(current_variant)" in
            dark)  target="light" ;;
            light) target="dark" ;;
            *)     target="dark" ;;
        esac
        ;;
    status)
        echo "Litho: $(current_variant)"
        exit 0
        ;;
    *)
        usage
        ;;
esac

echo "Switching to Litho $target..."

# 1. Repoint the active symlink (drives sway, mako, waybar, wofi includes)
ln -sfn "$target" "$ACTIVE_LINK"

# 2. Make Litho the active theme *family* for sway/mako/waybar/wofi
#    (only one family's active/ dir drives the WM chrome at a time — see
#    README.md "Coexisting with other themes". The [a-z]+ regex matches
#    any family name, so this doesn't need updating when a new theme is
#    added elsewhere.)
sed -i -E "s|swaywm/[a-z]+/active|swaywm/litho/active|" "$SWAY_CONF" "$MAKO_CONF" "$WAYBAR_CSS" "$WOFI_CSS"

# 3. swaylock has no include mechanism - copy the variant's config in place
cp "$LITHO_DIR/$target/swaylock.conf" "$SWAYLOCK_CFG"

# 4. kitty: comment out whichever colors/*.conf is currently active (any
#    theme family), then activate this one
sed -i -E "s|^include (\./colors/.+\.conf)|#include \1|" "$KITTY_CONF"
sed -i -E "s|^#include (\./colors/litho_${target}\.conf)|include \1|" "$KITTY_CONF"

# 5. Qt/KDE apps (Okular, Dolphin, ...) don't read swaywm/*/active or any of
#    the above - they read ~/.config/kdeglobals, which plasma-apply-colorscheme
#    populates from the matching ~/.local/share/color-schemes/*.colors file.
#    Without this they silently keep whatever scheme was last applied,
#    disconnected from the sway-level theme entirely.
target_cap="$(tr '[:lower:]' '[:upper:]' <<< "${target:0:1}")${target:1}"
if command -v plasma-apply-colorscheme >/dev/null 2>&1; then
    plasma-apply-colorscheme "Litho${target_cap}" >/dev/null 2>&1 || true
    echo "  Qt/KDE colour scheme applied (Litho${target_cap})"
fi

# 6. Firefox and Thunderbird don't read swaywm/*/active either - each has
#    its own top-level active symlink that a static userChrome.css/
#    userContent.css stub in the live profile always @imports. Neither
#    app hot-reloads chrome CSS, so this only takes effect on restart.
ln -sfn "litho/$target" "$HOME/.cfg-tzevaot/firefox/active"
ln -sfn "litho/$target" "$HOME/.cfg-tzevaot/thunderbird/active"
echo "  Firefox/Thunderbird theme set (restart both to see it)"

# 7. Reload the running apps
if [[ -n "${SWAYSOCK:-}" ]] && swaymsg -t get_version >/dev/null 2>&1; then
    swaymsg reload >/dev/null
    echo "  sway reloaded"
fi

if command -v makoctl >/dev/null 2>&1 && pgrep -x mako >/dev/null 2>&1; then
    makoctl reload >/dev/null 2>&1 || true
    echo "  mako reloaded"
fi

if pgrep -x waybar >/dev/null 2>&1; then
    pkill -SIGUSR2 waybar
    echo "  waybar reloaded"
fi

echo "Litho is now $target."
echo "kitty: press ctrl+shift+F5 in open windows, or restart, to pick up the new colors."
echo "vim: run :colorscheme litho_${target} in open sessions."
echo "Firefox/Thunderbird: restart to pick up the new theme."
