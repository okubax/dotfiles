#!/bin/bash
# himalaya-inbox - minimal interactive inbox browser for himalaya, which has
# no TUI of its own: list envelopes, read/delete/download by ID, compose a
# new one, loop. No deps beyond himalaya itself ($PAGER/$EDITOR, defaulting
# to less/vim).
#
# Usage: himalaya-inbox [-a account]

set -uo pipefail

page=1
account=""
[[ "${1:-}" == "-a" ]] && account="${2:-}"

list_accounts() {
    himalaya account list 2>/dev/null \
        | awk -F'┆' '/│/{gsub(/^[│ ]+|[ ]+$/,"",$1); if ($1!="" && $1!="NAME") print $1}'
}

pick_account() {
    local accounts=() i=1
    while IFS= read -r a; do accounts+=("$a"); done < <(list_accounts)
    if [[ ${#accounts[@]} -eq 0 ]]; then
        echo "No himalaya accounts configured." >&2
        exit 1
    fi
    if [[ ${#accounts[@]} -eq 1 ]]; then
        account="${accounts[0]}"
        return
    fi
    echo "Accounts:"
    for a in "${accounts[@]}"; do echo "  $i) $a"; ((i++)); done
    read -rp "Pick an account [1]: " choice
    choice="${choice:-1}"
    account="${accounts[$((choice - 1))]}"
}

compose() {
    local to subj tmpfile body confirm
    read -rp "To: " to
    [[ -n "$to" ]] || { echo "No recipient, aborting."; sleep 1; return; }
    read -rp "Subject: " subj
    tmpfile="$(mktemp)"
    "${EDITOR:-vim}" "$tmpfile"
    body="$(cat "$tmpfile")"
    rm -f "$tmpfile"
    if [[ -z "$body" ]]; then
        echo "Empty body, aborting."
        sleep 1
        return
    fi
    clear
    echo "To: $to"
    echo "Subject: $subj"
    echo "---"
    echo "$body"
    echo "---"
    read -rp "[s]end, save as [d]raft, or [c]ancel? " confirm
    case "$confirm" in
        s | S) himalaya -a "$account" message compose --to "$to" --subject "$subj" --body "$body" --send ;;
        d | D) himalaya -a "$account" message compose --to "$to" --subject "$subj" --body "$body" --save drafts ;;
        *) echo "Cancelled." ;;
    esac
    read -rp "Press enter to continue..." _
}

[[ -n "$account" ]] || pick_account

while true; do
    clear
    echo "== $account inbox (page $page) =="
    himalaya -a "$account" envelope list -p "$page"
    echo
    read -rp "ID read | d [id] delete | dl [id] download | c compose | [n/p]age | [a]ccount | [q]uit: " cmd arg
    case "$cmd" in
        q | Q) break ;;
        a | A) pick_account; page=1 ;;
        n | N) ((page++)) ;;
        p | P) ((page > 1)) && ((page--)) ;;
        c | C) compose ;;
        d | D)
            [[ -n "$arg" ]] || read -rp "Message ID to delete: " arg
            [[ -n "$arg" ]] || continue
            read -rp "Delete message $arg? [y/N] " confirm
            [[ "$confirm" =~ ^[Yy]$ ]] && himalaya -a "$account" message delete "$arg"
            ;;
        dl | DL)
            [[ -n "$arg" ]] || read -rp "Message ID to download attachments from: " arg
            [[ -n "$arg" ]] || continue
            himalaya -a "$account" attachment download "$arg"
            read -rp "Press enter to continue..." _
            ;;
        '') ;;
        *[!0-9]*) echo "Unknown command, ignoring."; sleep 1 ;;
        *)
            clear
            himalaya -a "$account" message read "$cmd" --seen | "${PAGER:-less}"
            ;;
    esac
done
