# mutt reads the local Maildir offlineimap already synced down — it never
# talks IMAP itself, and never needs OAuth2 (that's offlineimap's and
# msmtp's job). Sending goes through msmtp (see ../msmtp/msmtprc), picked
# explicitly via `-a <account>` from each account file below rather than
# From-header matching, since the active account is already known from
# whichever folder-hook last fired.
#
# This is a generic 2-account EXAMPLE matching offlineimap/offlineimap.conf
# and msmtp/msmtprc; add one account.<name> file + macro/folder-hook pair
# per mailbox you actually use.

set mbox_type   = Maildir
set sort        = reverse-date
set sort_browser = reverse-date
set delete      = yes
set mail_check  = 60

# Mutt's default on opening a mailbox is to jump the cursor to the first
# UNREAD message in sort order, not the newest one — with reverse-date sort
# that means it lands on whatever old message happens to still be unread,
# skipping over all the newer already-read mail above it. Force it back to
# the newest message (= first entry, since sort is reverse-date) every time
# a mailbox is opened instead.
folder-hook . "push <first-entry>"

# Header cache: without this, mutt re-parses every message's headers from
# scratch on every mailbox open — painful once a Maildir gets into the
# tens of thousands. One GDBM file per mailbox, keyed by path. No
# message_cache_dir — that only pays off avoiding IMAP re-fetches, and
# mutt never talks IMAP here (offlineimap's job). Needs mutt built with
# --enable-hcache (check: `mutt -v` lists a hcache backend) and the
# directory to exist first: mkdir -p ~/.cache/mutt/headers
#
# Deliberately its own top-level ~/.cache entry, NOT shared with tmpdir
# below: if you add a cache cleaner, protect "mutt" wholesale there (losing
# this means re-parsing every header again), while tmpdir below is a
# *sibling* dir precisely so it's NOT protected, and stays safe to clear
# on every run like any other disposable cache.
set header_cache = ~/.cache/mutt/headers

# Compose/attachment/pipe temp files: if /tmp is already tmpfs there's no
# speed difference, but mutt doesn't always clean up after a crash mid-
# compose, and plain /tmp makes those stragglers easy to lose track of. A
# dedicated dir a cache cleaner clears unconditionally is simpler than
# ever having to go hunting through /tmp for an old mutt-* file.
set tmpdir = ~/.cache/mutt-tmp

# HTML mail: render via w3m (mutt/mailcap) instead of showing raw markup or
# a bare attachment line. Own mailcap file first, then any mailcap you
# already have (e.g. from an unrelated tool) and the system defaults as
# fallback.
set mailcap_path = "~/.config/mutt/mailcap:~/.mailcap:/usr/share/mutt/mailcap:/etc/mutt/mailcap:/etc/mailcap"
auto_view text/html
alternative_order text/plain text/html

# Click links: \cb pipes the current message to urlview (../urlview — same
# tool/config used elsewhere in this repo, if you use it), which lists
# every URL it finds and opens the chosen one in firefox. pipe_decode hands
# urlview the MIME-decoded body rather than raw base64/quoted-printable
# source, so links inside an HTML part are actually visible to its regex.
set pipe_decode = yes
macro index,pager \cb "<pipe-message>urlview<enter>" "extract URLs with urlview"

# Mark every message in the current view as read in one step.
macro index \Cr "T~U<enter><tag-prefix><clear-flag>N<untag-pattern>.<enter>" "mark all messages as read"

# Saner copy/move: C/M already exist as copy-message/save-message, this
# just adds the mailbox browser (?<toggle-mailboxes>) instead of typing a
# path blind. save-message IS mutt's move (copy, then mark the original
# deleted), not a separate command.
macro index C "<copy-message>?<toggle-mailboxes>" "copy a message to a mailbox"
macro index M "<save-message>?<toggle-mailboxes>" "move a message to a mailbox"

# Gmail-safe delete: plain 'd' marks \Deleted + EXPUNGEs the message from
# wherever it sits locally — which for a Gmail account is "[Google Mail]/
# All Mail" (not INBOX; see offlineimap.conf's nametrans), and Gmail does
# not reliably honor an EXPUNGE issued against All Mail (confirmed via its
# own sync log: the same UIDs got re-deleted and re-downloaded every cycle,
# forever, regardless of the account's Auto-Expunge/"when expunged" IMAP
# settings). Moving the message into the Trash folder instead sidesteps
# that path entirely: it's a plain IMAP APPEND into "[Google Mail]/Bin",
# and Gmail's own backend then drops it out of All Mail as a side effect
# of the Trash label (All Mail is defined as everything EXCEPT Trash/Spam)
# — no EXPUNGE handshake required. Use E instead of d on a Gmail account;
# a real-IMAP-folder account doesn't have this bug, so plain 'd' is fine
# there (E will just harmlessly error — no local Trash folder — there).
macro index,pager E "<copy-message>=Trash<enter><delete-message>" "move message to Trash (Gmail-safe delete)"

# Colorscheme: matches whichever of litho/vellum/daguerre/verdigris-theme
# ran most recently (approximated to the nearest xterm 256-color, since
# mutt has no truecolor support like kitty/vim) — <family>-theme rewrites
# this line on every switch, the same way it already rewrites kitty's
# `include`. Edit by hand only if you want mutt on a different theme than
# the rest of the desktop.
source ~/.config/mutt/colors/litho_dark.muttrc

# Default account on startup.
source ~/.config/mutt/account.gmail

# Switch active account: syncs the current one, then sources the chosen
# account file and opens its inbox. folder-hook keeps $from/$sendmail
# correct too if you just navigate into another account's folder directly
# (<change-folder> without the macro).
macro index,pager <f2> '<sync-mailbox><enter-command>source ~/.config/mutt/account.gmail<enter><change-folder>!<enter>' "switch to gmail"
macro index,pager <f3> '<sync-mailbox><enter-command>source ~/.config/mutt/account.generic<enter><change-folder>!<enter>' "switch to generic"

folder-hook ~/.mail/gmail/.*   'source ~/.config/mutt/account.gmail'
folder-hook ~/.mail/generic/.* 'source ~/.config/mutt/account.generic'
