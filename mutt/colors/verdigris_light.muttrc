# Verdigris Light — mutt colors
# Nearest xterm 256-color approximation of each role in
# ../../swaywm/verdigris/light/palette.md (mutt has no truecolor
# support, unlike kitty/vim's exact hex). Wired into `verdigris-theme` —
# switching rewrites muttrc's `source .../mutt/colors/...muttrc` line to
# match, same as it already does for kitty's `include`.

color normal      color235 color255
color error       color130 color255
color message     color29 color255
color attachment   color29 color255
color markers     color246 color255
color tilde       color246 color255
color tree        color246 color255
color bold        color130 color255
color underline   color29 color255
color signature   color241 color255
color search      color255 color100
color indicator   color255 color130
color status      color235 color144
color prompt      color235 color144

color quoted       color29 color255
color quoted1      color65 color255
color quoted2      color100 color255
color quoted3      color96 color255
color quoted4      color241 color255

color hdrdefault   color241 color255
color header       color130 color255 "^(From|To|Cc|Subject|Date):"

color index        color255 color130 "~F"
color index        color130 color255 "~N"
color index        color241 color255 "~D"

# Same URL pattern as ~/.urlview's REGEXP, so a link is visibly a link in
# the pager before you ever press \cb to pipe the message to urlview.
color body         color29 color255 "(((https?|ftp)|gopher)|mailto)[.:][^ >\"\t]*|www\.[-a-z0-9.]+"
