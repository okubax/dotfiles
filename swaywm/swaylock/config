# Swaylock configuration — Zephyr Light
# Minimal look: blurred wallpaper with only a large clock visible.
# Triggered by $mod+Escape and by swayidle after 15 minutes (see sway config).
# Generated from ~/dotfiles/swaywm/zephyr/light/swaylock.conf by zephyr-theme;
# edit that file, not this one, then re-run `zephyr-theme light`.

ignore-empty-password
disable-caps-lock-text
image=~/.img/wallpapers/zephyr_light_lockscreen.png
font=Ubuntu Mono
effect-blur=30x2
fade-in=0.4

# Hide the default indicator ring/text entirely (everything fully transparent)
text-ver-color=00000000
text-wrong-color=00000000
text-clear-color=00000000
inside-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000
inside-clear-color=00000000
inside-caps-lock-color=00000000
ring-color=00000000
ring-ver-color=00000000
ring-wrong-color=00000000
ring-clear-color=00000000
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
key-hl-color=00000000
bs-hl-color=00000000
caps-lock-bs-hl-color=00000000
caps-lock-key-hl-color=00000000
separator-color=00000000

# Large clock in place of the indicator
scaling=fill
indicator
clock
timestr=%H:%M
datestr=
indicator-radius=350
font-size=125
text-color=3DAEE9
