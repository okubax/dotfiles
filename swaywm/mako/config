# Mako notification daemon
# Started from the sway config: exec /usr/bin/mako

font=Ubuntu Mono 9
max-icon-size=48
icon-location=right
margin=0,25,20
padding=10,5,10
width=200
border-size=2
border-radius=15
default-timeout=10000

# Color scheme: one of five theme families (Zephyr, Harmattan, Solarized,
# Nord, Catppuccin — see swaywm/<family>/README.md) — only one family
# drives this include at a time. Flip variants with `<family>-theme
# <variant>`; switch families by running any of the five scripts.
include=~/dotfiles/swaywm/zephyr/active/mako.conf

# Show notifications above fullscreen windows
layer=overlay
