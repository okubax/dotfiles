# Mako notification daemon
# Started from the sway config: exec /usr/bin/mako

font=Ubuntu Mono 9
max-icon-size=48
icon-location=right
margin=0,25,20
padding=10,5,10
width=200
border-size=2
border-radius=15
default-timeout=10000

# Color scheme: Zephyr (see ../zephyr/README.md) or Harmattan (see
# ../harmattan/README.md) — only one family drives this include at a time.
# Flip variants with `zephyr-theme`/`harmattan-theme`; switch families by
# running either.
include=~/dotfiles/swaywm/zephyr/active/mako.conf

# Show notifications above fullscreen windows
layer=overlay
