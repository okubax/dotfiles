# msmtp config — generic 2-account EXAMPLE matching offlineimap/offlineimap.conf.
# OAuth2 passwords come from ortie (token show -a <account> -r), the same
# token cache offlineimap/ortie itself use. -r makes ortie refresh the
# cached access token first if it's stale. Plain-password accounts pull
# from pass(1) instead.

defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        ~/.msmtp.log

account gmail
host         smtp.gmail.com
port         587
tls_starttls on
auth         xoauth2
from         YOUR_ADDRESS@gmail.com
user         YOUR_ADDRESS@gmail.com
passwordeval "ortie token show -a gmail -r"

account generic
host         smtp.example.com
port         465
tls_starttls off
auth         plain
from         you@example.com
user         you@example.com
passwordeval "pass show Mail/Example/you | head -1"

account default : gmail
