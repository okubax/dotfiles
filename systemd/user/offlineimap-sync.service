[Unit]
Description=Sync all offlineimap accounts to ~/.mail
StartLimitIntervalSec=0

[Service]
Type=oneshot
# -l gives offlineimap's own timestamped log file ("%Y-%m-%d %H:%M:%S LEVEL:
# message" per line, via its FileHandler) instead of the plain untimestamped
# lines a systemd StandardOutput=append: redirect would give — bin/sweep's
# clean_offlineimap_log() needs those real timestamps to trim by age. All
# WARNING/ERROR-level output already reaches this file too (same logger,
# same handler), so stdout/stderr are nulled rather than also sent to the
# journal. Create the directory first: mkdir -p ~/.local/state/offlineimap
ExecStart=/usr/bin/offlineimap -c /home/YOUR_USERNAME/dotfiles/offlineimap/offlineimap.conf -l /home/YOUR_USERNAME/.local/state/offlineimap/sync.log
StandardOutput=null
StandardError=null
